# Copiar a .env y completar las keys que tengas (ninguna es obligatoria).
# Sin keys el reproductor funciona en modo plantillas + Piper offline.

# Proveedor del cerebro: google | groq | openrouter
DJ_LLM_PROVIDER=google

# Google AI Studio (gratis, sin tarjeta): https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Groq (gratis): Whisper para voz + LLM de respaldo https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (modelos :free): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Forzar un modelo concreto (opcional)
# DJ_LLM_MODEL=gemini-3-flash-lite
# DJ_BRAIN_TIMEOUT=8
# DJ_BRAIN_DEBUG=1
